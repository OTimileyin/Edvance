[TEMPLATE]
# Copy to .env and fill in local values. Never commit the real .env.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/edvance
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Supabase Storage — private object storage for uploaded course materials
# (Phase 5). Leave these blank to run locally without uploads; the Sources
# upload form reports that object storage is not configured until they are set.
# Project URL (Supabase dashboard → Project Settings → API).
SUPABASE_URL=
# A server-side secret key. This is a SERVER ONLY secret: never prefix it with
# NEXT_PUBLIC_, never import it in a client component, and never commit it.
SUPABASE_SECRET_KEY=
# The private bucket name (e.g. edvance-materials). It must stay private.
SUPABASE_STORAGE_BUCKET=

# AI — course intelligence (Phase 6). Oyevolve uses one provider: Google Gemini.
# Create a key in Google AI Studio and store it here. This is a SERVER ONLY
# secret: it is read by lib/ai/gemini.ts on the server, never sent to the
# browser, and must never be prefixed with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: pin a specific model. Defaults to gemini-flash-latest.
# GEMINI_MODEL=


# Android app — see docs/ANDROID_APP_RUNBOOK.md.
# The SHA-256 fingerprint of the certificate the APK was signed with, colon
# separated (e.g. AA:BB:...:99). It is public information — it is published at
# /.well-known/assetlinks.json so Android can verify the app against this site —
# but it is deployment-specific, so it lives here rather than in the source.
# Blank is a valid state: the endpoint then returns an empty list and the app
# opens as a Custom Tab with browser UI, rather than claiming a certificate it
# cannot prove.
ANDROID_APP_FINGERPRINT=
# Optional: owner/name of the GitHub repository whose Releases host the APK.
# Defaults to OTimileyin/Oyevolve.
# ANDROID_RELEASE_REPO=
