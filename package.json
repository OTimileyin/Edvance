{
  "name": "edvance",
  "version": "0.3.0",
  "private": true,
  "description": "Evidence-first assessment intelligence — learning workspace",
  "scripts": {
    "dev": "infisical run --env=dev -- next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "check": "npm run typecheck && npm run test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "migrate": "infisical run --env=dev -- node scripts/migrate.mjs",
    "test:ingestion": "infisical run --env=dev -- node scripts/test-ingestion.mjs",
    "test:intelligence": "infisical run --env=dev -- node scripts/test-course-intelligence.mjs",
    "test:assessment": "infisical run --env=dev -- node scripts/test-assessment-intelligence.mjs",
    "test:mastery": "infisical run --env=dev -- node scripts/test-mastery-intelligence.mjs",
    "test:revision": "infisical run --env=dev -- node scripts/test-targeted-revision.mjs",
    "test:hardening": "infisical run --env=dev -- node scripts/test-product-hardening.mjs",
    "verify:remote": "node scripts/verify-remote-deployment.mjs",
    "verify:remote:specific": "node scripts/verify-remote-deployment.mjs https://white-whale.spcf.app",
    "verify:remote:diff": "node scripts/verify-remote-deployment.mjs --diff",
    "watch:deploy": "node scripts/watch-deployment.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@supabase/supabase-js": "^2.117.2",
    "better-auth": "^1.7.6",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint",
    "*": "prettier --ignore-unknown --check"
  }
}
