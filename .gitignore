# Dependencies
node_modules/

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Runtime logs
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Package manager state
.yarn/
.pnpm-store/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/

# Local agent tooling (reinstallable skills). `.claude/` holds vendored copies of
# third-party skills — reinstallable, not ours to review — while the repository's
# own account of how to use them lives in docs/SKILLS_PLAYBOOK.md.
.claude/
.opencode/
.specific
specific.local

# Local scratch (agent tooling)
.freebuff/
.tmp-scratch/
.playwright-cli/

# End-to-end test artifacts. The saved session cookie jar is per-run state, and
# the reports and traces are for the run that produced them.
e2e/.auth/
playwright-report/
test-results/
